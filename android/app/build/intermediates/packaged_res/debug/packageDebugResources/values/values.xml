<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#4A90E2</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="widget_background">#FFFFFFFF</color>
    <color name="widget_text_primary">#1A1A1A</color>
    <color name="widget_text_secondary">#6E6E6E</color>
    <string name="about">About</string>
    <string name="about_description">A simple widget to display the current week number on your Android phone\'s home and lock screens.</string>
    <string name="about_title">About</string>
    <string name="app_name">Week Number Widget</string>
    <string name="home_widget_description">Displays the current week number on your home screen</string>
    <string name="lock_screen_widget_description">Displays the current week number on your lock screen</string>
    <string name="refresh">Refresh</string>
    <string name="week_number_label">Week Number (%1$d)</string>
    <string name="widget_instructions">1. Long press on your home screen\n2. Select \"Widgets\"\n3. Find \"Week Number Widget\"\n4. Drag to your desired location\n5. Resize the widget to your preferred size\n\nFor lock screen:\n1. Go to Settings > Lock Screen\n2. Enable lock screen widgets\n3. Add widget from widget menu</string>
    <style name="Theme.WeekNumberWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#4A90E2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FAFAFA</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="colorSurfaceVariant">#F0F0F0</item>
        <item name="colorOnSurfaceVariant">#6E6E6E</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>