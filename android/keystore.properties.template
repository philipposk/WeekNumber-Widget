# Keystore Properties Template
# 
# IMPORTANT: 
# 1. Copy this file to 'keystore.properties' (without .template)
# 2. Fill in your actual keystore credentials
# 3. NEVER commit 'keystore.properties' or '.jks' files to version control!
# 4. The real 'keystore.properties' file is already in .gitignore

# Path to your keystore file (relative to project root)
storeFile=app/week-number-widget-release.jks

# Password for the keystore
storePassword=YOUR_KEYSTORE_PASSWORD_HERE

# Alias name for your key (use the alias you specified when creating the keystore)
keyAlias=week-number-widget

# Password for your key (can be same as storePassword, or different)
keyPassword=YOUR_KEY_PASSWORD_HERE

